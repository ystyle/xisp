;; ============================================================
;; Xisp 语言完整测试套件
;; 用法：
;;   AST 模式：    xisp lisp-tests/comprehensive_test.lisp
;;   字节码模式：  xisp --with-bytecode-compiler lisp-tests/comprehensive_test.lisp
;;   预期两种模式输出完全一致
;; ============================================================

(define pass-count 0)
(define fail-count 0)

(define (assert-equal expected actual)
  (if (= expected actual)
    (begin (set! pass-count (+ pass-count 1)) #t)
    (begin
      (println "  ❌ 期望: " expected " 实际: " actual)
      (set! fail-count (+ fail-count 1))
      #f)))

;; ============================================================
;; 1. 常量/字面量
;; ============================================================
(println "")
(println "=== 1. 常量/字面量 ===")
(assert-equal 42 42)
(assert-equal 3 3)
(assert-equal 1 (if (< 1 2) 1 0))

;; ============================================================
;; 2. 算术运算（二元）
;; ============================================================
(println "")
(println "=== 2. 算术运算 ===")
(assert-equal 3 (+ 1 2))
(assert-equal 0 (- 5 5))
(assert-equal 6 (* 2 3))
(assert-equal 2 (/ 6 3))
(assert-equal 10 (+ (* 2 3) 4))
(assert-equal 6 (* (+ 1 1) (+ 2 1)))

;; ============================================================
;; 3. 变量
;; ============================================================
(println "")
(println "=== 3. 变量 ===")
(define a 42)
(assert-equal 42 a)
(set! a 100)
(assert-equal 100 a)

;; ============================================================
;; 4. 控制流
;; ============================================================
(println "")
(println "=== 4. 控制流 ===")
(assert-equal 1 (if #t 1 2))
(assert-equal 2 (if #f 1 2))
(assert-equal 3 (begin 1 2 3))
(assert-equal 30 (begin (define x 10) (define y 20) (+ x y)))

;; ============================================================
;; 5. 逻辑运算
;; ============================================================
(println "")
(println "=== 5. 逻辑运算 ===")
(assert-equal 42 (and #t 42))
(assert-equal 42 (or #f 42))
(assert-equal 1 (if (or #t #f) 1 0))
(assert-equal 1 (if (not #f) 1 0))

;; ============================================================
;; 6. let 绑定
;; ============================================================
(println "")
(println "=== 6. let 绑定 ===")
(assert-equal 3 (let ((x 1) (y 2)) (+ x y)))
(assert-equal 30 (let ((a 10) (b 20)) (+ a b)))

;; ============================================================
;; 7. 函数
;; ============================================================
(println "")
(println "=== 7. 函数 ===")
(define (square x) (* x x))
(assert-equal 25 (square 5))

(define (add a b) (+ a b))
(assert-equal 7 (add 3 4))

(define (fact n)
  (if (< n 2) 1 (* n (fact (- n 1)))))
(assert-equal 120 (fact 5))
(assert-equal 1 (fact 1))

(define (fib n)
  (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(assert-equal 55 (fib 10))

(define (multi a b c d) (+ a b c d))

;; ============================================================
;; 8. lambda
;; ============================================================
(println "")
(println "=== 8. lambda ===")
(define double (lambda (x) (* x 2)))
(assert-equal 10 (double 5))

(define (make-adder n)
  (lambda (x) (+ x n)))
(define add5 (make-adder 5))
(assert-equal 9 (add5 4))

(assert-equal 6 ((lambda (x y) (+ x y)) 2 4))

;; ============================================================
;; 9. condb
;; ============================================================
(println "")
(println "=== 9. condb ===")
(assert-equal 1 (condb #t 1 else 2))
(assert-equal 2 (condb #f 1 else 2))

;; ============================================================
;; 10. match
;; ============================================================
(println "")
(println "=== 10. match ===")
(assert-equal 1 (match 1 (1 1) (2 2) (else 0)))
(assert-equal 2 (match 2 (1 1) (2 2) (else 0)))
(assert-equal 0 (match 99 (1 1) (2 2) (else 0)))

;; ============================================================
;; 11. 列表操作
;; ============================================================
(println "")
(println "=== 11. 列表操作 ===")
(assert-equal 1 (first '(1 2 3)))
(assert-equal 6 (sum '(1 2 3)))

;; ============================================================
;; 12. 哈希映射
;; ============================================================
(println "")
(println "=== 12. 哈希映射 ===")
(define h {:a 1 :b 2})
(assert-equal 1 (hget h :a))
(assert-equal 2 (hget h :b))

;; ============================================================
;; 13. 高阶函数
;; ============================================================
(println "")
(println "=== 13. 高阶函数 ===")
(assert-equal 6 (reduce + 0 '(1 2 3)))

;; ============================================================
;; 14. 管道
;; ============================================================
(println "")
(println "=== 14. 管道 ===")
(assert-equal 16 (-> 5 (+ 3) (* 2)))

;; ============================================================
;; 15. 宏
;; ============================================================
(println "")
(println "=== 15. 宏 ===")
(defmacro twice (x) (list x x))
(assert-equal 42 (car (twice 42)))

;; ============================================================
;; 16. 字符串插值
;; ============================================================
(println "")
(println "=== 16. 字符串插值 ===")
(let ((x 42)) (println #"x=#{x}"))

;; ============================================================
;; 17. 递归
;; ============================================================
(println "")
(println "=== 17. 递归 ===")
(define (deep n) (if (< n 1) 0 (+ 1 (deep (- n 1)))))
(assert-equal 100 (deep 100))

;; ============================================================
;; 结果
;; ============================================================
(println "")
(println "============================================")
(println "  测试完成")
(println "  通过: " pass-count)
(println "  失败: " fail-count)
(if (= fail-count 0)
  (println "  ✅ 全部通过!")
  (println "  ❌ 有失败用例"))
(println "============================================")
